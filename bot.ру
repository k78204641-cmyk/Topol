# ==================== БАЗА ДАННЫХ ====================
def init_db():
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS users (
            user_id INTEGER PRIMARY KEY,
            trial_until TEXT,
            sub_until TEXT
        )
    """)
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS tasks (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER,
            title TEXT,
            task_date TEXT,
            task_time TEXT,
            recurrence TEXT,
            is_active INTEGER DEFAULT 1
        )
    """)
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS schedules (
            user_id INTEGER PRIMARY KEY,
            schedule_text TEXT
        )
    """)
    conn.commit()
    conn.close()

init_db()

def db_execute(query, params=(), fetchone=False, fetchall=False, commit=False):
    conn = sqlite3.connect(DB_NAME)
    try:
        cursor = conn.cursor()
        cursor.execute(query, params)
        res = None
        if fetchone:
            res = cursor.fetchone()
        elif fetchall:
            res = cursor.fetchall()
        if commit:
            conn.commit()
        return res
    finally:
        conn.close()

# ==================== ПРОВЕРКА ПОДПИСКИ ====================
def is_subscribed(user_id: int) -> bool:
    user = db_execute("SELECT trial_until, sub_until FROM users WHERE user_id = ?", (user_id,), fetchone=True)
    now = datetime.now(MSK)
    if not user:
        # Автоматическая регистрация и выдача пробного периода на 2 суток
        trial_until = (now + timedelta(days=2)).isoformat()
        db_execute("INSERT INTO users (user_id, trial_until, sub_until) VALUES (?, ?, ?)", (user_id, trial_until, ""), commit=True)
        return True
    
    trial_until_str, sub_until_str = user
    if trial_until_str:
        if now <= datetime.fromisoformat(trial_until_str):
            return True
    if sub_until_str:
        if now <= datetime.fromisoformat(sub_until_str):
            return True
    return False

