    dp.include_router(router)
    
    logger.info("Бот успешно запущен и готов к работе.")
    
    # Запуск веб-сервера и Telegram polling параллельно
    await asyncio.gather(
        start_web_server(),
        dp.start_polling(bot)
    )


if __name__ == "__main__":
