@router.callback_query(F.data.startswith("m_chart_"))
async def callback_music_chart(callback_query: CallbackQuery):
    page = int(callback_query.data.split("_")[2])
    async with aiohttp.ClientSession() as session:
        async with session.get("https://itunes.apple.com/ru/rss/topsongs/limit=50/json") as resp:
