@router.message(BotStates.waiting_for_weather_city)
async def weather_get(message: Message, state: FSMContext):
    city = message.text.strip()
    await state.clear()
    
    async with aiohttp.ClientSession() as session:
        try:
            # 1. Получаем координаты города через бесплатный геокодер Open-Meteo
            geo_url = f"https://geocoding-api.open-meteo.com/v1/search?name={city}&count=1&language=ru&format=json"
            async with session.get(geo_url, timeout=10) as resp:
                geo_data = await resp.json()
                results = geo_data.get("results")
                if not results:
                    await message.answer("❌ Город не найден. Попробуйте еще раз.", reply_markup=main_menu_keyboard())
                    return
                lat = results[0]["latitude"]
                lon = results[0]["longitude"]
                name = results[0]["name"]
                country = results[0].get("country", "")

            # 2. Получаем погоду по координатам (без ключей)
            weather_url = f"https://api.open-meteo.com/v1/forecast?latitude={lat}&longitude={lon}&current=temperature_2m,relative_humidity_2m,apparent_temperature,wind_speed_10m,weather_code&timezone=Europe/Moscow"
            async with session.get(weather_url, timeout=10) as resp:
                if resp.status != 200:
                    await message.answer("❌ Ошибка при получении данных о погоде.", reply_markup=main_menu_keyboard())
                    return
                data = await resp.json()
                current = data.get("current", {})
                
                temp = current.get("temperature_2m")
                feels_like = current.get("apparent_temperature")
                humidity = current.get("relative_humidity_2m")
                wind = current.get("wind_speed_10m")
                w_code = current.get("weather_code", 0)
                
                # Расшифровка кодов погоды WMO
                weather_descriptions = {
                    0: "Ясно ☀️", 1: "Преимущественно ясно 🌤", 2: "Переменная облачность ⛅️", 3: "Пасмурно ☁️",
                    45: "Туман 🌫", 48: "Изморозь ❄️", 51: "Лёгкая морось 🌧", 61: "Дождь 🌧", 71: "Снег ❄️", 95: "Гроза ⚡️"
                }
                desc = weather_descriptions.get(w_code, "Без осадков")
                update_time = datetime.datetime.now(MOSCOW_TZ).strftime("%d.%m.%Y %H:%M:%S")
                
                text = (
                    f"🌤 Погода в городе **{name}** ({country}):\n\n"
                    f"• Температура: **{temp}°C** (ощущается как {feels_like}°C)\n"
                    f"• Описание: {desc}\n"
                    f"• Влажность: **{humidity}%**\n"
                    f"• Скорость ветра: **{wind} м/с**\n\n"
                    f"🕒 Обновлено: {update_time} (МСК)"
                )
                await message.answer(text, reply_markup=main_menu_keyboard(), parse_mode="Markdown")
        except Exception as e:
            logger.error(f"Weather error: {e}")
            await message.answer("❌ Произошла ошибка при запросе погоды.", reply_markup=main_menu_keyboard())


