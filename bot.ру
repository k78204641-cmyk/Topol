DB_NAME = "bot_database.db"

def init_db():
    """Инициализация и миграция таблиц базы данных SQLite."""
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS users (
            user_id INTEGER PRIMARY KEY,
            zodiac TEXT,
            city TEXT,
            schedule TEXT,
            notify_time TEXT DEFAULT '08:00',
            subscription_expires_at TEXT
        )
    """)
    
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS tasks (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER,
            task_text TEXT,
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
    """)
    
    cursor.execute("PRAGMA table_info(users)")
    columns = [col[1] for col in cursor.fetchall()]
    if "subscription_expires_at" not in columns:
        cursor.execute("ALTER TABLE users ADD COLUMN subscription_expires_at TEXT")
        
    conn.commit()
    conn.close()

def get_user(user_id: int):
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    cursor.execute("SELECT user_id, zodiac, city, schedule, notify_time, subscription_expires_at FROM users WHERE user_id = ?", (user_id,))
    row = cursor.fetchone()
    conn.close()
    return row

def save_user_profile(user_id: int, zodiac: str, city: str):
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    
    cursor.execute("SELECT subscription_expires_at FROM users WHERE user_id = ?", (user_id,))
    row = cursor.fetchone()
    
    if not row or not row[0]:
        # Ровно 24 часа триала
        trial_expire = datetime.now() + timedelta(hours=TRIAL_HOURS)
        expires_str = trial_expire.isoformat()
    else:
        expires_str = row[0]

    cursor.execute("""
        INSERT INTO users (user_id, zodiac, city, subscription_expires_at) 
        VALUES (?, ?, ?, ?) 
        ON CONFLICT(user_id) DO UPDATE SET zodiac=excluded.zodiac, city=excluded.city
    """, (user_id, zodiac, city, expires_str))
    conn.commit()
    conn.close()

def is_subscription_active(user_id: int) -> bool:
    """Проверка, активна ли подписка или триал у пользователя."""
    user = get_user(user_id)
    if not user or not user[5]:
        return False
    try:
        expires_at = datetime.fromisoformat(user[5])
        return datetime.now() < expires_at
    except (ValueError, TypeError):
        return False

def extend_subscription(user_id: int, days: int = 30):
    """Продление подписки на указанное количество дней."""
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    cursor.execute("SELECT subscription_expires_at FROM users WHERE user_id = ?", (user_id,))
    row = cursor.fetchone()
    
    now = datetime.now()
    if row and row[0]:
        try:
            current_exp = datetime.fromisoformat(row[0])
            start_from = max(now, current_exp)
        except ValueError:
            start_from = now
    else:
        start_from = now
        
    new_exp = start_from + timedelta(days=days)
    cursor.execute("UPDATE users SET subscription_expires_at = ? WHERE user_id = ?", (new_exp.isoformat(), user_id))
    conn.commit()
    conn.close()
    return new_exp

def update_user_schedule(user_id: int, schedule: str):
