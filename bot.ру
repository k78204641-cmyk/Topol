@router.message(ScheduleState.waiting_for_input, F.document)
async def process_schedule_pdf(message: types.Message, state: FSMContext):
    doc = message.document
    if doc.file_size > 5 * 1024 * 1024:
        await message.answer("❌ Размер файла превышает 5 МБ.")
        return
    if not doc.file_name.lower().endswith(".pdf"):
        await message.answer("❌ Поддерживаются только PDF-файлы.")
        return

    file_info = await message.bot.get_file(doc.file_id)
    file_bytes = await message.bot.download_file(file_info.file_path)

    try:
        reader = PdfReader(file_bytes)
        text = ""
        for page in reader.pages:
            t = page.extract_text()
            if t:
                text += t + "\n"
        if not text.strip():
            await message.answer("⚠️ Не удалось извлечь текст из PDF. Возможно, это скан. Потребуется OCR.")
            return
    except Exception:
        await message.answer("❌ Ошибка при чтении PDF файла.")
        return

    today_str = datetime.now(TZ).strftime("%d.%m.%Y")
    user_id = message.from_user.id

    async with aiosqlite.connect(DB_PATH) as db:
        cursor = await db.execute(
            "INSERT INTO schedules (telegram_id, schedule_date, raw_text) VALUES (?, ?, ?)",
            (user_id, today_str, text.strip())
        )
        await db.commit()

    await state.clear()
    await message.answer(f"✅ Расписание из PDF успешно сохранено на сегодня ({today_str})!", reply_markup=get_main_menu())


