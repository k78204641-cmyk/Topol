async def get_schedule_from_text(saved_text: str, raw_date_query: str) -> str:
    """Интеллектуальный поиск расписания по сохраненному пользователем тексту"""
    parsed_date = parse_date_input(raw_date_query)
    lines = [line.strip() for line in saved_text.split("\n") if line.strip()]
    keywords = [raw_date_query.lower()]
    
    try:
        dt = datetime.strptime(parsed_date, "%Y-%m-%d")
        months = ["января", "февраля", "марта", "апреля", "мая", "июня", "июля", "августа", "сентября", "октября", "ноября", "декабря"]
        weekdays = ["понедельник", "вторник", "среда", "четверг", "пятница", "суббота", "воскресенье"]
        keywords.append(f"{dt.day:02d}.{dt.month:02d}")
        keywords.append(f"{dt.day} {months[dt.month-1]}")
        keywords.append(weekdays[dt.weekday()])
    except Exception:
        pass

    matched_blocks = []
    capturing = False
    current_block = []

    for line in lines:
        line_low = line.lower()
        if any(kw in line_low for kw in keywords):
            if current_block:
                matched_blocks.append("\n".join(current_block))
                current_block = []
            capturing = True

        if capturing:
            current_block.append(line)
            if len(current_block) >= 15:
                matched_blocks.append("\n".join(current_block))
                current_block = []
                capturing = False

    if current_block:
        matched_blocks.append("\n".join(current_block))

    if matched_blocks:
        res_text = "\n\n---\n\n".join(matched_blocks[:3])
        if len(res_text) > 3500:
            res_text = res_text[:3500] + "\n...(сокращено)"
        return f"📅 **Расписание на {raw_date_query}:**\n\n{res_text}"
    else:
        return f"ℹ️ В вашем расписании не найдено упоминаний по запросу «{raw_date_query}».\n\n📄 **Полное сохраненное расписание:**\n{saved_text[:3000]}"

