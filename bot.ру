@router.message(BotStates.waiting_for_task_time)
async def task_get_time(message: Message, state: FSMContext):
    user_id = message.from_user.id
    data = await state.get_data()
    title = data.get("title")
    time_text = message.text.strip()
    await state.clear()
    
    due_time = None
    if time_text != "-":
        try:
            due_time = datetime.datetime.strptime(time_text, "%Y-%m-%d %H:%M").replace(tzinfo=MOSCOW_TZ)
        except ValueError:
            await message.answer("❌ Неверный формат времени. Задача добавлена без напоминания.", reply_markup=main_menu_keyboard())
    
    async with aiosqlite.connect(DATABASE_PATH) as db:
        cursor = await db.execute(
            "INSERT INTO tasks (user_id, title, due_time, is_done) VALUES (?, ?, ?, 0)",
            (user_id, title, due_time.isoformat() if due_time else None)
        )
        task_id = cursor.lastrowid
        await db.commit()
        
        if due_time:
            scheduler.add_job(
                send_reminder,
                "date",
                run_date=due_time,
                args=[user_id, title],
                id=f"task_{task_id}",
                replace_existing=True
            )
            
    await message.answer("✅ Задача успешно добавлена!", reply_markup=main_menu_keyboard())


