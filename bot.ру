async def restore_reminders():
    async with aiosqlite.connect(DATABASE_PATH) as db:
        async with db.execute("SELECT id, user_id, title, due_time, is_done FROM tasks WHERE is_done = 0") as cursor:
            rows = await cursor.fetchall()
            now = datetime.datetime.now(MOSCOW_TZ)
            for row in rows:
                task_id, user_id, title, due_time_str, _ = row
                if due_time_str:
                    due_time = datetime.datetime.fromisoformat(due_time_str)
                    if due_time > now:
                        scheduler.add_job(
                            send_reminder,
                            "date",
                            run_date=due_time,
                            args=[user_id, title],
                            id=f"task_{task_id}",
                            replace_existing=True
                        )


