@router.message(BotStates.waiting_for_ai_prompt)
async def ai_process(message: Message, state: FSMContext):
    prompt = message.text.strip()
    await state.clear()
    
    if not openai_client:
        await message.answer("❌ AI API не инициализирован.", reply_markup=main_menu_keyboard())
        return
        
    try:
        response = await openai_client.chat.completions.create(
            model="gpt-4o-mini",
            messages=[{"role": "user", "content": prompt}],
            max_tokens=1000
        )
        answer_text = response.choices[0].message.content
        await message.answer(answer_text, reply_markup=main_menu_keyboard())
    except Exception as e:
        logger.error(f"AI error: {e}")
        await message.answer("❌ Ошибка при обращении к нейросети. Попробуйте позже.", reply_markup=main_menu_keyboard())


