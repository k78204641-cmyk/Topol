# --- Middleware для проверки доступа/триала ---
class AccessMiddleware(BaseMiddleware):
    async def __call__(self, handler, event, data):
        user = getattr(event, "from_user", None)
        if user and not user.is_bot:
            # Пропускаем команду /start и оплату
            message_text = getattr(event, "text", "") or ""
            if message_text.startswith("/start") or message_text.startswith("/pay") or message_text == "💳 Оплатить подписку":
                return await handler(event, data)
            
            is_allowed = await db.check_user_access(user.id)
            if not is_allowed:
                text = (
                    "🔒 **Ваш бесплатный пробный период (2 дня) истек.**\n\n"
                    "Для продолжения использования всех функций бота необходимо оформить подписку.\n"
                    "Стоимость: **100 руб.**"
                )
                kb = InlineKeyboardMarkup(inline_keyboard=[
                    [InlineKeyboardButton(text="💳 Оплатить 100 руб.", callback_query_handler="pay_sub")]
                ])
                if isinstance(event, Message):
                    await event.answer(text, reply_markup=kb, parse_mode="Markdown")
                elif isinstance(event, CallbackQuery):
                    await event.message.answer(text, reply_markup=kb, parse_mode="Markdown")
                    await event.answer()
                return

        return await handler(event, data)

