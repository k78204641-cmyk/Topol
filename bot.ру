async def fetch_weather(city: str) -> str:
    """Получение фактической погоды через wttr.in в метрической системе"""
    url = f"https://wttr.in/{city}?format=3&lang=ru&m"
    try:
        async with aiohttp.ClientSession() as session:
            async with session.get(url, timeout=10) as resp:
                if resp.status != 200:
                    return f"❌ Город «{city}» не найден или сервис погоды недоступен."
                text = await resp.text()
                text = text.strip()
                if not text or "Unknown location" in text or "Sorry" in text:
                    return f"❌ Город «{city}» не найден."
                return f"🌤 {text}"
    except Exception as e:
        return f"❌ Ошибка получения погоды: {e}"

