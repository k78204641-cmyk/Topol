            async with db.execute("SELECT day, content FROM schedules WHERE user_id = ?", (callback_query.from_user.id,)) as cursor:
                rows = await cursor.fetchall()
                if not rows:
                    await callback_query.message.answer("Расписание пусто.", reply_markup=main_menu_keyboard())
                    await callback_query.answer()
                    return
                text = "📅 **Ваше расписание:**\n\n" + "".join([f"📌 **{r[0]}**:\n{r[1]}\n\n" for r in rows])
                await callback_query.message.answer(text, reply_markup=main_menu_keyboard(), parse_mode="Markdown")
                await callback_query.answer()
    except Exception as e:
        logger.error(f"Schedule view error: {e}")
        await callback_query.answer("❌ Запрос выдать не получилось.")


