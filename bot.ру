    horoscope_info = await get_horoscope(zodiac_key)
    
    sched_info = f"📅 Расписание:\n{schedule}" if schedule else "📅 Расписание: Не добавлено. (/schedule)"
    
    tasks = get_user_tasks(user_id)
    tasks_info = f"📋 Дела:\n" + "\n".join([f"• {t[1]}" for t in tasks]) if tasks else "📋 Дела: Нет запланированных дел."
    
    today_date = datetime.now().strftime("%d.%m.%Y")
    return f"☀️ Утренний дайджест на {today_date}\n\n{weather_info}\n\n{horoscope_info}\n\n{sched_info}\n\n{tasks_info}\n\nХорошего дня! 🚀"

async def send_daily_digest(bot: Bot):
    users = get_all_users()
    logger.info("Запуск утренней рассылки...")
    
    for user in users:
        user_id = user[0]
        expires_str = user[4]
        
        if expires_str:
            try:
                if datetime.now() < datetime.fromisoformat(expires_str):
                    text = await build_morning_message(user_id)
                    await bot.send_message(user_id, text, disable_web_page_preview=True)
                    await asyncio.sleep(0.05)
                    continue
            except ValueError:
                pass

        try:
            await bot.send_message(
                user_id, 
                "⏰ Время утреннего дайджеста!\n\nВаш бесплатный период/подписка истекли. Оформите подписку за 150 руб./мес, чтобы снова получать утренние сводки.",
                reply_markup=get_pay_keyboard()
            )
        except Exception:
            pass

# ==================== ЗАПУСК ====================

async def handle(request):
    return web.Response(text="Bot is running!")

async def main():
    app = web.Application()
    app.router.add_get("/", handle)
    runner = web.AppRunner(app)
    await runner.setup()
    port = int(os.environ.get("PORT", 8080))
    site = web.TCPSite(runner, "0.0.0.0", port)
    await site.start()

    init_db()
    bot = Bot(token=BOT_TOKEN)
    dp = Dispatcher(storage=MemoryStorage())
    dp.include_router(router)
    
    scheduler = AsyncIOScheduler(timezone="Europe/Moscow")
    scheduler.add_job(send_daily_digest, 'cron', hour=8, minute=0, args=[bot])
    scheduler.start()
    
    # Очищаем все зависшие/старые сообщения из очереди Telegram при старте
    await bot.delete_webhook(drop_pending_updates=True)
    
    logger.info("Бот с системой подписок успешно запущен!")
    await dp.start_polling(bot)

if __name__ == "__main__":
    asyncio.run(main())
