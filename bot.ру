@router.callback_query(TaskState.repeat, F.data.startswith("rep_"))
async def task_repeat(callback: types.CallbackQuery, state: FSMContext):
    repeat_type = callback.data.split("_")[1]
    data = await state.get_data()
    user_id = callback.from_user.id
    await state.clear()

    async with aiosqlite.connect(DB_PATH) as db:
        cursor = await db.execute(
            """
            INSERT INTO tasks (telegram_id, title, description, task_date, task_time, repeat_type, status, remind_enabled)
            VALUES (?, ?, ?, ?, ?, ?, 'active', 1)
        """,
            (user_id, data["title"], data["description"], data["date"], data["time"], repeat_type),
        )
        task_id = cursor.lastrowid

        # Создаем напоминание
        dt_str = f"{data['date']} {data['time']}"
        remind_dt = datetime.strptime(dt_str, "%d.%m.%Y %H:%M").replace(tzinfo=TZ)
        await db.execute(
            "INSERT INTO reminders (task_id, remind_at, is_sent) VALUES (?, ?, 0)",
            (task_id, remind_dt.isoformat()),
        )
        await db.commit()

    await callback.message.edit_text(
        f"✅ Дело успешно создано!\n\n"
        f"📌 Название: {data['title']}\n"
        f"📅 Дата: {data['date']} {data['time']} (МСК)\n"
        f"🔄 Повторение: {repeat_type}",
        reply_markup=get_main_menu(),
    )
    await callback.answer()


@router.message(Command("tasks"))
@router.callback_query(F.data == "menu_tasks")
async def list_tasks(event: types.Message | types.CallbackQuery):
    user_id = event.from_user.id
    async with aiosqlite.connect(DB_PATH) as db:
        async with db.execute(
            "SELECT id, title, task_date, task_time, status FROM tasks WHERE telegram_id = ? ORDER BY task_date, task_time",
            (user_id,),
        ) as cursor:
            rows = await cursor.fetchall()

    if not rows:
        msg = "📭 У вас пока нет созданных дел."
        if isinstance(event, types.CallbackQuery):
            await event.message.answer(msg)
            await event.answer()
        else:
            await event.answer(msg)
        return

    text = "📋 **Ваши дела:**\n\n"
    for r in rows:
        t_id, title, t_date, t_time, status = r
        icon = "✅" if status == "completed" else "⏳"
        text += f"{icon} **{title}** — {t_date} в {t_time} (ID: {t_id})\n"

    # Отправим список с кнопкой управления для первого активного
    active_rows = [r for r in rows if r[4] == "active"]
    if isinstance(event, types.CallbackQuery):
        if active_rows:
            first_id = active_rows[0][0]
            await event.message.answer(text, reply_markup=get_task_action_keyboard(first_id), parse_mode="Markdown")
        else:
            await event.message.answer(text, parse_mode="Markdown")
        await event.answer()
    else:
