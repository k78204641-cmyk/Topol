@router.callback_query(F.data.startswith("rem_"))
async def reminder_callback_router(callback: types.CallbackQuery):
    parts = callback.data.split("_")
    action = parts[1]
    t_id = int(parts[2])

    async with aiosqlite.connect(DB_PATH) as db:
        if action == "done":
            await db.execute("UPDATE tasks SET status = 'completed', remind_enabled = 0 WHERE id = ?", (t_id,))
            await db.execute("UPDATE reminders SET is_sent = 1 WHERE task_id = ?", (t_id,))
            await db.commit()
            await callback.message.answer("✅ Дело отмечено как выполненное.")
        elif action == "del":
            await db.execute("DELETE FROM tasks WHERE id = ?", (t_id,))
            await db.execute("DELETE FROM reminders WHERE task_id = ?", (t_id,))
            await db.commit()
            await callback.message.answer("🗑 Дело удалено.")
        elif action == "off":
            await db.execute("UPDATE tasks SET remind_enabled = 0 WHERE id = ?", (t_id,))
            await db.execute("UPDATE reminders SET is_sent = 1 WHERE task_id = ?", (t_id,))
            await db.commit()
            await callback.message.answer("🔕 Напоминания отключены.")
        elif action == "postpone":
            new_remind = datetime.now(TZ) + timedelta(minutes=10)
            await db.execute(
                "INSERT INTO reminders (task_id, remind_at, is_sent) VALUES (?, ?, 0)",
                (t_id, new_remind.isoformat())
            )
            await db.commit()
            await callback.message.answer(f"⏳ Напоминание отложено на 10 минут (на {new_remind.strftime('%H:%M')}).")
    await callback.answer()


# --- ФОНОВЫЙ ПЛАНИРОВЩИК НАПОМИНАНИЙ ---
async def reminders_worker(bot: Bot):
    while True:
        try:
            now_str = datetime.now(TZ).isoformat()
            async with aiosqlite.connect(DB_PATH) as db:
                async with db.execute(
                    """
                    SELECT r.id, r.task_id, t.telegram_id, t.title, t.task_date, t.task_time, t.repeat_type
                    FROM reminders r
                    JOIN tasks t ON r.task_id = t.id
                    WHERE r.is_sent = 0 AND r.remind_at <= ? AND t.remind_enabled = 1
                """,
                    (now_str,)
                ) as cursor:
                    reminders = await cursor.fetchall()

                for rem in reminders:
                    r_id, task_id, t_id, title, t_date, t_time, repeat_type = rem
                    # Отправляем уведомление
                    try:
                        await bot.send_message(
                            chat_id=t_id,
                            text=(
                                f"🔔 **Напоминание**\n\n"
                                f"Дело: **{title}**\n"
                                f"Время: `{t_time}`\n"
                                f"Дата: `{t_date}`"
                            ),
                            reply_markup=get_reminder_action_keyboard(task_id),
                            parse_mode="Markdown"
                        )
                    except Exception as e:
                        logger.error(f"Не удалось отправить напоминание пользователю {t_id}: {e}")

                    # Помечаем напоминание отправленным
                    await db.execute("UPDATE reminders SET is_sent = 1 WHERE id = ?", (r_id,))

                    # Обработка повторений
                    if repeat_type != "none":
                        dt_current = datetime.strptime(f"{t_date} {t_time}", "%d.%m.%Y %H:%M")
                        if repeat_type == "daily":
                            dt_next = dt_current + timedelta(days=1)
                        elif repeat_type == "weekdays":
                            dt_next = dt_current + timedelta(days=1)
                            while dt_next.weekday() >= 5: # Суббота-воскресенье
                                dt_next += timedelta(days=1)
                        elif repeat_type == "weekly":
                            dt_next = dt_current + timedelta(weeks=1)
                        else:
                            dt_next = None

                        if dt_next:
                            next_date_str = dt_next.strftime("%d.%m.%Y")
                            next_time_str = dt_next.strftime("%H:%M")
                            next_remind_dt = dt_next.replace(tzinfo=TZ)
                            await db.execute(
                                "UPDATE tasks SET task_date = ?, task_time = ? WHERE id = ?",
                                (next_date_str, next_time_str, task_id)
                            )
                            await db.execute(
                                "INSERT INTO reminders (task_id, remind_at, is_sent) VALUES (?, ?, 0)",
                                (task_id, next_remind_dt.isoformat())
                            )
                await db.commit()
        except Exception as e:
            logger.error(f"Ошибка в фоне напоминаний: {e}")
        await asyncio.sleep(60)


# --- ЗАПУСК БОТА ---
async def main():
    await init_db()
    bot = Bot(token=BOT_TOKEN)
    dp = Dispatcher()
    dp.include_router(router)

    # Запускаем фоновый воркер напоминаний
    asyncio.create_task(reminders_worker(bot))

    logger.info("Бот запущен и работает 24/7...")
    try:
        await dp.start_polling(bot, allowed_updates=dp.resolve_used_update_types())
    finally:
        await bot.session.close()


if __name__ == "__main__":
    try:
        asyncio.run(main())
    except (KeyboardInterrupt, SystemExit):
        logger.info("Бот остановлен пользователем.")
