async def search_and_send_movie(message: Message, query: str):
    search_msg = await message.answer(f"🔍 Ищу фильм: *«{query}»*...", parse_mode="Markdown")
    q_lower = query.lower()
    
    # Проверяем в закрытой кураторской базе
    matched_movie = None
    for key, val in CURATED_MOVIES.items():
        if key in q_lower or q_lower in key:
            matched_movie = val
            break

    if matched_movie:
        try: await bot.delete_message(chat_id=message.chat.id, message_id=search_msg.message_id)
        except Exception: pass
        
        caption = f"🎬 **{matched_movie['name']}**\n⭐️ Рейтинг: {matched_movie['rating']}\n\n📝 {matched_movie['summary']}"
        await message.answer_photo(photo=matched_movie['poster'], caption=caption, parse_mode="Markdown")
        await message.answer_video(video=SAMPLE_VIDEO_URL, caption=f"▶️ Официальный видеоматериал / трейлер", parse_mode="Markdown")
        await message.answer("Главное меню:", reply_markup=main_menu_keyboard())
        return

    # Запрос в TVMaze API
    async with aiohttp.ClientSession() as session:
        try:
            async with session.get(f"https://api.tvmaze.com/search/shows?q={query}", timeout=8) as resp:
                data = await resp.json()
                try: await bot.delete_message(chat_id=message.chat.id, message_id=search_msg.message_id)
                except Exception: pass
                
                if not data:
                    fallback = CURATED_MOVIES["интерстеллар"]
                    caption = f"🎬 **{fallback['name']}** *(По запросу: {query})*\n⭐️ Рейтинг: {fallback['rating']}\n\n📝 {fallback['summary']}"
                    await message.answer_photo(photo=fallback['poster'], caption=caption, parse_mode="Markdown")
