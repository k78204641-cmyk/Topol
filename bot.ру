                    f"🌤 Погода в городе **{name}** ({country}):\n\n"
                    f"• Температура: **{cur.get('temperature_2m')}°C** (ощущается как {cur.get('apparent_temperature')}°C)\n"
                    f"• Влажность: **{cur.get('relative_humidity_2m')}%**\n"
                    f"• Ветер: **{cur.get('wind_speed_10m')} м/с**"
                )
                await message.answer(text, reply_markup=main_menu_keyboard(), parse_mode="Markdown")
        except Exception:
            await message.answer("❌ Ошибка при получении погоды.", reply_markup=main_menu_keyboard())


