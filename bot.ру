WEATHER_API_KEY = "YOUR_OPENWEATHER_API_KEY"  # Замените на API-ключ от openweathermap.org (опционально)

# Состояния для ConversationHandler (FSM)
ZODIAC, CITY = range(2)
TASK_TEXT, TASK_TIME = range(2, 4)

# Список знаков зодиака для кнопок
ZODIAC_SIGNS = [
    "Овен", "Телец", "Близнецы", "Рак",
    "Лев", "Дева", "Весы", "Скорпион",
