async def fetch_weather(city_name: str) -> str:
    async with aiohttp.ClientSession() as session:
        geo_url = f"https://geocoding-api.open-meteo.com/v1/search?name={city_name}&count=1&language=ru&format=json"
        async with session.get(geo_url) as resp:
            if resp.status != 200:
                return "❌ Ошибка геолокации."
            geo_data = await resp.json()
            results = geo_data.get("results")
            if not results:
                return f"❌ Город '{city_name}' не найден."
            loc = results[0]
            lat, lon, name = loc["latitude"], loc["longitude"], loc["name"]
            country = loc.get("country", "")

        weather_url = f"https://api.open-meteo.com/v1/forecast?latitude={lat}&longitude={lon}&current=temperature_2m,relative_humidity_2m,wind_speed_10m"
        async with session.get(weather_url) as resp:
            if resp.status != 200:
                return "❌ Ошибка получения погоды."
            w_data = await resp.json()
            curr = w_data.get("current", {})
            temp = curr.get("temperature_2m")
            humidity = curr.get("relative_humidity_2m")
            wind = curr.get("wind_speed_10m")

            return (
                f"🌍 **Погода в г. {name} ({country}):**\n\n"
                f"🌡 Температура: {temp}°C\n"
                f"💧 Влажность: {humidity}%\n"
                f"💨 Ветер: {wind} м/с"
            )

def create_youmoney_link(user_id: int, amount: int) -> str:
    comment = f"sub_{user_id}"
    return (
        f"https://yoomoney.ru/quickpay/confirm.xml?"
        f"receiver={YOUMONEY_WALLET}&"
        f"quickpay-form=shop&"
        f"targets=Подписка+на+бота&"
        f"paymentType=SB&"
        f"sum={amount}&"
        f"label={comment}"
    )

async def check_youmoney_payment(user_id: int) -> bool:
    if not YOUMONEY_TOKEN:
        return False
    url = "https://yoomoney.ru/api/operation-history"
    headers = {
        "Authorization": f"Bearer {YOUMONEY_TOKEN}",
        "Content-Type": "application/x-www-form-encoding"
    }
    payload = {
        "type": "deprecation",
        "label": f"sub_{user_id}",
        "records": 5
    }
    try:
        async with aiohttp.ClientSession() as session:
            async with session.post(url, headers=headers, data=payload) as resp:
                if resp.status == 200:
                    data = await resp.json()
                    operations = data.get("operations", [])
                    for op in operations:
                        if op.get("status") == "success" and float(op.get("amount", 0)) >= SUBSCRIPTION_PRICE:
                            return True
    except Exception as e:
        logger.error(f"ЮMoney API Error: {e}")
    return False

