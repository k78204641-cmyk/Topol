@router.callback_query(F.data.startswith("music_chart_page_"))
async def callback_music_chart(callback_query: CallbackQuery):
    page = int(callback_query.data.split("_")[3])
    url = "https://itunes.apple.com/ru/rss/topsongs/limit=50/json"
    
    async with aiohttp.ClientSession() as session:
        try:
            async with session.get(url, timeout=10) as resp:
                data = await resp.json()
                entries = data.get("feed", {}).get("entry", [])
                if not entries:
                    await callback_query.answer("Чарты временно недоступны.")
                    return

                start_idx = page * 10
                end_idx = start_idx + 10
                current_batch = entries[start_idx:end_idx]

                text = f"🔥 **Чарты Apple Music (Топ-50) — Часть {page + 1}/5:**\nВыберите песню кнопкой, чтобы получить аудиофайл:"
                buttons = []
                for idx, entry in enumerate(current_batch, start_idx + 1):
                    song_name = entry.get("im:name", {}).get("label", "Без названия")
                    artist_name = entry.get("im:artist", {}).get("label", "Исполнитель")
                    short_title = f"{idx}. {artist_name} - {song_name}"[:40]
                    buttons.append([InlineKeyboardButton(text=short_title, callback_data=f"play_track_{idx}")])

                nav_buttons = []
                if page > 0:
                    nav_buttons.append(InlineKeyboardButton(text="⬅️ Назад", callback_data=f"music_chart_page_{page - 1}"))
                if end_idx < len(entries):
                    nav_buttons.append(InlineKeyboardButton(text="Вперед ➡️", callback_data=f"music_chart_page_{page + 1}"))
                if nav_buttons:
                    buttons.append(nav_buttons)

                keyboard = InlineKeyboardMarkup(inline_keyboard=buttons)
                await callback_query.message.edit_text(text, reply_markup=keyboard, parse_mode="Markdown")
                await callback_query.answer()
        except Exception as e:
