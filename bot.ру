async def init_db():
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute("""
            CREATE TABLE IF NOT EXISTS users (
                user_id INTEGER PRIMARY KEY,
                registered_at TEXT NOT NULL,
                paid_until TEXT DEFAULT NULL
            )
        """)
        await db.execute("""
            CREATE TABLE IF NOT EXISTS reminders (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                user_id INTEGER NOT NULL,
                task_text TEXT NOT NULL,
                remind_at TEXT NOT NULL,
                is_sent INTEGER DEFAULT 0
            )
        """)
        await db.commit()

async def get_or_create_user(user_id: int):
    async with aiosqlite.connect(DB_PATH) as db:
        async with db.execute("SELECT registered_at, paid_until FROM users WHERE user_id = ?", (user_id,)) as cursor:
            row = await cursor.fetchone()
            if row:
                return row
            now_str = datetime.now().isoformat()
            await db.execute("INSERT INTO users (user_id, registered_at, paid_until) VALUES (?, ?, NULL)", (user_id, now_str))
            await db.commit()
            return (now_str, None)

async def set_user_subscription(user_id: int, days: int = 30):
    async with aiosqlite.connect(DB_PATH) as db:
        async with db.execute("SELECT paid_until FROM users WHERE user_id = ?", (user_id,)) as cursor:
            row = await cursor.fetchone()
            current_paid_until = row[0] if row else None

        now = datetime.now()
        base_time = now
        if current_paid_until:
            dt_current = datetime.fromisoformat(current_paid_until)
            if dt_current > now:
                base_time = dt_current
        
        until_dt = base_time + timedelta(days=days)
        await db.execute("UPDATE users SET paid_until = ? WHERE user_id = ?", (until_dt.isoformat(), user_id))
        await db.commit()

async def get_subscription_info(user_id: int):
    reg_at_str, paid_until_str = await get_or_create_user(user_id)
    now = datetime.now()

    # 1. Проверяем платную подписку
    if paid_until_str:
        paid_until = datetime.fromisoformat(paid_until_str)
        if paid_until > now:
            diff = paid_until - now
            days = diff.days
            hours = diff.seconds // 3600
            return "paid", f"{days} дн. {hours} ч."

    # 2. Проверяем 2-дневный пробный период
    reg_date = datetime.fromisoformat(reg_at_str)
    trial_end = reg_date + timedelta(days=2)
    if trial_end > now:
        diff = trial_end - now
        days = diff.days
        hours = diff.seconds // 3600
        return "trial", f"{days} дн. {hours} ч."

    return "expired", "0 дн."

async def check_user_access(user_id: int) -> bool:
    status, _ = await get_subscription_info(user_id)
    return status in ("paid", "trial")

async def add_reminder(user_id: int, task_text: str, remind_at_iso: str):
    async with aiosqlite.connect(DB_PATH) as db:
        await db.execute(
            "INSERT INTO reminders (user_id, task_text, remind_at, is_sent) VALUES (?, ?, ?, 0)",
            (user_id, task_text, remind_at_iso)
        )
        await db.commit()

async def get_user_reminders(user_id: int):
    async with aiosqlite.connect(DB_PATH) as db:
        async with db.execute("SELECT task_text, remind_at FROM reminders WHERE user_id = ? AND is_sent = 0 ORDER BY remind_at ASC", (user_id,)) as cursor:
            return await cursor.fetchall()

async def get_pending_reminders(now_iso: str):
    async with aiosqlite.connect(DB_PATH) as db:
        async with db.execute("SELECT id, user_id, task_text FROM reminders WHERE remind_at <= ? AND is_sent = 0", (now_iso,)) as cursor:
            return await cursor.fetchall()

async def mark_reminder_sent(reminder_id: int):
