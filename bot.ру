# ==================== ВЕБ-СЕРВЕР И ВСТРОЕННЫЙ SELF-PING ДЛЯ 24/7 ====================
async def handle_ping(request):
    return aiohttp.web.Response(text="Bot is running 24/7 successfully!")

async def start_web_server():
    app = aiohttp.web.Application()
    app.router.add_get("/", handle_ping)
    app.router.add_get("/health", handle_ping)
    runner = aiohttp.web.AppRunner(app)
    await runner.setup()
    port = int(os.environ.get("PORT", 10000))
    site = aiohttp.web.TCPSite(runner, "0.0.0.0", port)
    await site.start()
    logger.info(f"HTTP web server started on port {port}")

async def background_self_ping():
    """Автоматический пинг внешнего URL Render для предотвращения сна 24/7"""
    await asyncio.sleep(20)
    async with aiohttp.ClientSession() as session:
        while True:
            render_url = os.getenv("RENDER_EXTERNAL_URL")
            if render_url:
                target = f"{render_url}/health"
                try:
                    async with session.get(target, timeout=10) as resp:
                        logger.info(f"Self-ping status: {resp.status}")
                except Exception as e:
                    logger.debug(f"Self-ping exception: {e}")
            await asyncio.sleep(300)


# ==================== ЗАПУСК ====================
async def main():
    await init_db()
    await restore_reminders()
    scheduler.start()
    dp.include_router(router)
    logger.info("Бот полностью запущен и работает 24/7.")
    
    await asyncio.gather(
        start_web_server(),
        background_self_ping(),
        dp.start_polling(bot)
    )


if __name__ == "__main__":
