@router.message(FormStates.waiting_for_task_datetime)
async def process_task_datetime(message: Message, state: FSMContext):
    dt_text = message.text.strip()
    try:
        dt_obj = datetime.strptime(dt_text, "%Y-%m-%d %H:%M")
        dt_msk = MSK_TZ.localize(dt_obj)
        data = await state.get_data()
        await add_reminder(message.from_user.id, data["task_text"], dt_msk.isoformat())
        await state.clear()
        await message.answer(f"✅ Напоминание установлено на **{dt_text} (МСК)**!", parse_mode="Markdown")
    except ValueError:
        await message.answer("❌ Неверный формат! Введите дату и время как `ГГГГ-ММ-ДД ЧЧ:ММ`:", parse_mode="Markdown")

# --- Загрузка и просмотр расписания ---
@router.message(F.text == "📚 Загрузить расписание")
async def schedule_upload_click(message: Message, state: FSMContext):
    await state.clear()
    await state.set_state(FormStates.waiting_for_schedule_text)
    await message.answer("📥 Пришлите расписание **текстом** или **PDF-файлом**.")

@router.message(FormStates.waiting_for_schedule_text, F.content_type.in_({"text", "document"}))
async def process_schedule(message: Message, state: FSMContext):
    text_content = ""
    if message.text:
        text_content = message.text
    elif message.document and message.document.mime_type == "application/pdf":
        await message.answer("⏳ Чтение PDF-файла...")
        file_bytes = await bot.download(message.document)
        pdf_data = file_bytes.read()
        
        try:
            reader = PdfReader(io.BytesIO(pdf_data))
            for page in reader.pages:
                t = page.extract_text()
                if t: text_content += t + "\n"
        except Exception as e:
            logger.error(f"PdfReader error: {e}")

    if not text_content.strip():
        await message.answer("❌ Не удалось извлечь текст из PDF. Убедитесь, что файл содержит текстовый слой.")
        return

    await save_schedule_day(message.from_user.id, "общие", text_content.strip())
    await state.clear()
    await message.answer("✅ Расписание успешно сохранено!", reply_markup=get_main_keyboard())

