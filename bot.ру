@router.message(BotStates.waiting_for_music_query)
async def music_perform_search(message: Message, state: FSMContext):
    query = message.text.strip()
    await state.clear()
    
    url = f"https://itunes.apple.com/search?term={query}&entity=song&limit=5&country=RU"
    async with aiohttp.ClientSession() as session:
        try:
            async with session.get(url, timeout=10) as resp:
                if resp.status != 200:
                    await message.answer("❌ Ошибка при поиске музыки.", reply_markup=main_menu_keyboard())
                    return
                data = await resp.json()
                results = data.get("results", [])
                
                if not results:
                    await message.answer("Ничего не найдено по вашему запросу.", reply_markup=main_menu_keyboard())
                    return
                
                text = f"🎵 Результаты поиска по запросу *{query}*:\n\n"
                for idx, track in enumerate(results, 1):
                    artist = track.get("artistName", "Неизвестен")
                    track_name = track.get("trackName", "Без названия")
                    preview_url = track.get("previewUrl")
