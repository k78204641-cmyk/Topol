            if page > 0: nav.append(InlineKeyboardButton(text="⬅️ Назад", callback_data=f"m_chart_{page-1}"))
            if end < len(entries): nav.append(InlineKeyboardButton(text="Вперед ➡️", callback_data=f"m_chart_{page+1}"))
