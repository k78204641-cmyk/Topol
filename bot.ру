    await state.clear()

    db_execute(
        "INSERT INTO tasks (user_id, task_text, task_date) VALUES (?, ?, ?)",
        (message.from_user.id, task_text, formatted_date),
        commit=True
    )
    await message.answer(f"✅ **Дело сохранено!**\n📌 {task_text}\n📆 {formatted_date}", reply_markup=get_main_keyboard())

