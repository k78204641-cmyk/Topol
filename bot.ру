DB_NAME = "bot_database.db"

def init_db():
    """Инициализация и миграция таблиц базы данных SQLite."""
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    
    # Таблица пользователей с полем даты окончания подписки
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS users (
            user_id INTEGER PRIMARY KEY,
            zodiac TEXT,
            city TEXT,
            schedule TEXT,
            notify_time TEXT DEFAULT '08:00',
            subscription_expires_at TEXT
        )
    """)
    
    # Таблица дел/напоминаний
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS tasks (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER,
            task_text TEXT,
            created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
        )
    """)
    
    # Проверка наличия колонки subscription_expires_at для старых баз
    cursor.execute("PRAGMA table_info(users)")
    columns = [col[1] for col in cursor.fetchall()]
    if "subscription_expires_at" not in columns:
        cursor.execute("ALTER TABLE users ADD COLUMN subscription_expires_at TEXT")
        
    conn.commit()
    conn.close()

def get_user(user_id: int):
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    cursor.execute("SELECT user_id, zodiac, city, schedule, notify_time, subscription_expires_at FROM users WHERE user_id = ?", (user_id,))
    row = cursor.fetchone()
    conn.close()
    return row

def save_user_profile(user_id: int, zodiac: str, city: str):
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    
    # Проверяем, существует ли уже пользователь
    cursor.execute("SELECT subscription_expires_at FROM users WHERE user_id = ?", (user_id,))
    row = cursor.fetchone()
    
    if not row or not row[0]:
        # Если новый пользователь — выдаем бесплатный пробный период 1 день
        trial_expire = datetime.now() + timedelta(days=TRIAL_DAYS)
        expires_str = trial_expire.isoformat()
    else:
        expires_str = row[0]

    cursor.execute("""
        INSERT INTO users (user_id, zodiac, city, subscription_expires_at) 
        VALUES (?, ?, ?, ?) 
        ON CONFLICT(user_id) DO UPDATE SET zodiac=excluded.zodiac, city=excluded.city
    """, (user_id, zodiac, city, expires_str))
    conn.commit()
    conn.close()

def is_subscription_active(user_id: int) -> bool:
    """Проверка, активна ли подписка или триал у пользователя."""
    user = get_user(user_id)
    if not user or not user[5]:
        return False
    expires_at = datetime.fromisoformat(user[5])
    return datetime.now() < expires_at

def extend_subscription(user_id: int, days: int = 30):
    """Продление подписки на указанное количество дней."""
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    cursor.execute("SELECT subscription_expires_at FROM users WHERE user_id = ?", (user_id,))
    row = cursor.fetchone()
    
    now = datetime.now()
    if row and row[0]:
        current_exp = datetime.fromisoformat(row[0])
        start_from = max(now, current_exp)
    else:
        start_from = now
        
    new_exp = start_from + timedelta(days=days)
    cursor.execute("UPDATE users SET subscription_expires_at = ? WHERE user_id = ?", (new_exp.isoformat(), user_id))
    conn.commit()
    conn.close()
    return new_exp

def update_user_schedule(user_id: int, schedule: str):
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    cursor.execute("UPDATE users SET schedule = ? WHERE user_id = ?", (schedule, user_id))
    conn.commit()
    conn.close()

def add_user_task(user_id: int, task_text: str):
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    cursor.execute("INSERT INTO tasks (user_id, task_text) VALUES (?, ?)", (user_id, task_text))
    conn.commit()
    conn.close()

def get_user_tasks(user_id: int):
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    cursor.execute("SELECT id, task_text FROM tasks WHERE user_id = ?", (user_id,))
    rows = cursor.fetchall()
    conn.close()
    return rows

def delete_user_task(task_id: int, user_id: int):
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    cursor.execute("DELETE FROM tasks WHERE id = ? AND user_id = ?", (task_id, user_id))
    conn.commit()
    conn.close()

def clear_user_tasks(user_id: int):
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    cursor.execute("DELETE FROM tasks WHERE user_id = ?", (user_id,))
    conn.commit()
    conn.close()

def get_all_users():
    conn = sqlite3.connect(DB_NAME)
    cursor = conn.cursor()
    cursor.execute("SELECT user_id, zodiac, city, schedule, subscription_expires_at FROM users WHERE zodiac IS NOT NULL AND city IS NOT NULL")
    rows = cursor.fetchall()
    conn.close()
    return rows


