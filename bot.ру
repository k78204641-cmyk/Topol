async def get_weather(city: str) -> str:
    """Получение прогноза погоды через Open-Meteo с быстрым таймаутом."""
    timeout = aiohttp.ClientTimeout(total=5)
    try:
        async with aiohttp.ClientSession(timeout=timeout) as session:
            geo_url = f"https://geocoding-api.open-meteo.com/v1/search?name={city}&count=1&language=ru"
            async with session.get(geo_url) as resp:
                if resp.status != 200:
                    return f"🌡 Погода: Не удалось получить данные для города {city}."
                geo_data = await resp.json()
                if not geo_data.get("results"):
                    return f"🌡 Погода: Не удалось найти город {city}."
                
                lat = geo_data["results"][0]["latitude"]
                lon = geo_data["results"][0]["longitude"]
                city_name = geo_data["results"][0].get("name", city)

            weather_url = f"https://api.open-meteo.com/v1/forecast?latitude={lat}&longitude={lon}&current_weather=true&daily=temperature_2m_max,temperature_2m_min&timezone=auto"
            async with session.get(weather_url) as resp:
                if resp.status != 200:
                    return f"🌡 Погода в г. {city_name}: Временно недоступна."
                data = await resp.json()
                current = data.get("current_weather", {})
                temp = current.get("temperature", "N/A")
                wind = current.get("windspeed", "N/A")
                
                daily = data.get("daily", {})
                temp_max = daily.get("temperature_2m_max", [temp])[0]
                temp_min = daily.get("temperature_2m_min", [temp])[0]

                return (
                    f"🌡 Погода в г. {city_name}:\n"
                    f"• Сейчас: {temp}°C\n"
                    f"• Днем: от {temp_min}°C до {temp_max}°C\n"
                    f"• Скорость ветра: {wind} км/ч"
                )
    except Exception as e:
        logger.error(f"Ошибка погоды: {e}")
        return "🌡 Погода: Временно недоступна."

async def get_horoscope(zodiac_key: str) -> str:
    """Получение гороскопа на день с быстрым таймаутом."""
    sign_ru = ZODIAC_NAMES_RU.get(zodiac_key, zodiac_key.capitalize())
    timeout = aiohttp.ClientTimeout(total=5)
    try:
        async with aiohttp.ClientSession(timeout=timeout) as session:
            url = f"https://horoscope-app-api.vercel.app/v1/get-horoscope/daily?sign={zodiac_key}&day=TODAY"
            async with session.get(url) as resp:
                if resp.status == 200:
                    data = await resp.json()
                    text = data.get("data", {}).get("horoscope_data", "")
