# ==================== ФОНОВЫЕ СЕРВИСНЫЕ ЗАДАЧИ (24/7) ====================
async def reminder_loop(bot: Bot):
    """Фоновый планировщик проверки задач по местному времени пользователя каждую минуту"""
    while True:
        await asyncio.sleep(60)
        try:
            now_utc = datetime.utcnow()
            
            tasks = db_execute(
                "SELECT t.id, t.user_id, t.task_text, t.task_date, t.remind_time, u.utc_offset "
                "FROM tasks t JOIN users u ON t.user_id = u.user_id "
                "WHERE t.is_notified = 0",
                fetchall=True
            )
            
            if tasks:
                for task_id, user_id, task_text, task_date, remind_time, utc_offset in tasks:
                    offset = utc_offset if utc_offset is not None else 3
                    user_now = now_utc + timedelta(hours=offset)
                    user_now_date = user_now.strftime("%Y-%m-%d")
                    user_now_time = user_now.strftime("%H:%M")
                    
                    if task_date == user_now_date and remind_time == user_now_time:
                        try:
                            await bot.send_message(
                                chat_id=user_id,
                                text=f"⏰ **Напоминание о деле:**\n\n📌 {task_text}"
                            )
                            db_execute("UPDATE tasks SET is_notified = 1 WHERE id = ?", (task_id,), commit=True)
                        except Exception as e:
                            logging.error(f"Не удалось отправить напоминание пользователю {user_id}: {e}")
        except Exception as e:
            logging.error(f"Ошибка в цикле напоминаний: {e}")

async def self_ping():
    """Само-пинг веб-сервера для удержания активности на бесплатном тарифе Render"""
    app_url = os.getenv("RENDER_EXTERNAL_URL")
    if not app_url:
        return
    while True:
        await asyncio.sleep(600)
        try:
            async with aiohttp.ClientSession() as session:
                async with session.get(f"{app_url}/health") as resp:
                    logging.info(f"Self-ping status: {resp.status}")
        except Exception as e:
            logging.error(f"Self-ping error: {e}")

async def start_web_server():
    """Запуск легкого aiohttp сервера для удержания сетевого порта на Render"""
    app = web.Application()
    async def handle_ping(request):
        return web.Response(text="Bot OK")
    app.router.add_get('/', handle_ping)
    app.router.add_get('/health', handle_ping)
    runner = web.AppRunner(app)
    await runner.setup()
    port = int(os.getenv("PORT", 10000))
    site = web.TCPSite(runner, '0.0.0.0', port)
    await site.start()
    logging.info(f"Веб-сервер успешно запущен на порту {port}")

# ==================== ЗАПУСК ПРИЛОЖЕНИЯ ====================
dp.include_router(router)

async def main():
    bot = Bot(token=BOT_TOKEN)
    try:
        await bot.delete_webhook(drop_pending_updates=True)
        logging.info("Бот успешно запущен и работает 24/7!")
        
        await asyncio.gather(
            start_web_server(),
            self_ping(),
            reminder_loop(bot),
            dp.start_polling(bot, allowed_updates=["message", "callback_query", "pre_checkout_query"])
        )
    except Exception as e:
        logging.critical(f"Критическая ошибка при запуске бота: {e}")
        traceback.print_exc()
    finally:
        await bot.session.close()

if __name__ == "__main__":
    try:
        asyncio.run(main())
    except KeyboardInterrupt:
        print("Бот остановлен.")
