@router.message(StateFilter(ScheduleStates.waiting_for_text), F.document)
async def process_schedule_pdf(message: Message, state: FSMContext):
    doc = message.document
    if doc.mime_type != "application/pdf":
        await message.answer("❌ Поддерживаются только файлы в формате PDF.")
        return
    if doc.file_size > 10 * 1024 * 1024:
        await message.answer("❌ Размер файла превышает 10 МБ.")
        return
    
    file = await message.bot.get_file(doc.file_id)
    file_bytes = await message.bot.download_file(file.file_path)
    
    try:
        reader = pypdf.PdfReader(io.BytesIO(file_bytes.read()))
        extracted_text = ""
        for page in reader.pages:
            t = page.extract_text()
            if t:
                extracted_text += t + "\n"
        
        if not extracted_text.strip():
            await message.answer("⚠️ Не удалось извлечь текст из PDF. Возможно, это документ-скан и потребуется OCR.")
            return
        
        db_execute("INSERT OR REPLACE INTO schedules (user_id, schedule_text) VALUES (?, ?)", (message.from_user.id, extracted_text.strip()), commit=True)
        await state.clear()
        await message.answer("✅ Расписание из PDF успешно загружено и сохранено!", reply_markup=get_main_keyboard())
    except Exception as e:
        logger.error(f"PDF extraction error: {e}")
        await message.answer("❌ Ошибка при чтении PDF файла.")

