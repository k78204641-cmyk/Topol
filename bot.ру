async def save_schedule_url(message: Message, state: FSMContext):
    url = message.text.strip()
    if not url.startswith("http"):
        await message.answer("❌ Ссылка должна начинаться с http:// или https://. Попробуйте снова:")
        return
    await state.clear()
    db_execute("UPDATE users SET schedule_url = ? WHERE user_id = ?", (url, message.from_user.id), commit=True)
    await message.answer("✅ Ссылка на расписание успешно сохранена!", reply_markup=get_main_keyboard())

