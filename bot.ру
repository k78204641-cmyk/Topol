# ==================== БАЗА ДАННЫХ ====================
async def init_db():
    async with aiosqlite.connect(DATABASE_PATH) as db:
        await db.execute("""
            CREATE TABLE IF NOT EXISTS users (
                user_id INTEGER PRIMARY KEY,
                trial_end TEXT,
                sub_end TEXT,
                created_at TEXT
            )
        """)
        await db.execute("""
            CREATE TABLE IF NOT EXISTS tasks (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                user_id INTEGER,
                title TEXT,
                due_time TEXT,
                is_done INTEGER DEFAULT 0
            )
        """)
        await db.execute("""
            CREATE TABLE IF NOT EXISTS schedules (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                user_id INTEGER,
                day TEXT,
                content TEXT,
                UNIQUE(user_id, day)
            )
        """)
        await db.execute("""
            CREATE TABLE IF NOT EXISTS playlists (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                user_id INTEGER,
                name TEXT,
                track_info TEXT
            )
        """)
        await db.execute("""
            CREATE TABLE IF NOT EXISTS payments (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                user_id INTEGER,
                amount REAL,
                timestamp TEXT
            )
        """)
        await db.commit()


async def get_or_create_user(user_id: int):
    now = datetime.datetime.now(MOSCOW_TZ)
    async with aiosqlite.connect(DATABASE_PATH) as db:
        async with db.execute("SELECT trial_end, sub_end FROM users WHERE user_id = ?", (user_id,)) as cursor:
            row = await cursor.fetchone()
            if not row:
                trial_end = (now + datetime.timedelta(days=2)).isoformat()
                await db.execute(
                    "INSERT INTO users (user_id, trial_end, sub_end, created_at) VALUES (?, ?, ?, ?)",
                    (user_id, trial_end, None, now.isoformat())
                )
                await db.commit()
                return trial_end, None
            return row[0], row[1]


async def check_access(user_id: int) -> bool:
    trial_end_str, sub_end_str = await get_or_create_user(user_id)
    now = datetime.datetime.now(MOSCOW_TZ)
    
    if trial_end_str:
        trial_end = datetime.datetime.fromisoformat(trial_end_str)
        if now < trial_end:
            return True
            
    if sub_end_str:
        sub_end = datetime.datetime.fromisoformat(sub_end_str)
        if now < sub_end:
            return True
            
    return False


