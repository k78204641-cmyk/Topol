# --- МИДЛВАРЬ ПРОВЕРКИ ПОДПИСКИ ---
async def subscription_middleware(handler, event, data):
    user = event.from_user
    if not user:
        return await handler(event, data)

    # Разрешаем служебные команды и оплату без проверки
    if isinstance(event, types.Message) and event.text:
        cmd = event.text.split()[0].lower()
        if cmd in ["/start", "/help", "/subscription"]:
            return await handler(event, data)
    if isinstance(event, types.CallbackQuery) and event.data and (
        event.data.startswith("menu_subscription") or event.data in ["buy_subscription", "menu_help"]
    ):
        return await handler(event, data)

    now = datetime.now(TZ)
    async with aiosqlite.connect(DB_PATH) as db:
        async with db.execute("SELECT trial_ends_at FROM users WHERE telegram_id = ?", (user.id,)) as cursor:
            row = await cursor.fetchone()
            if not row:
                return await handler(event, data) # Пропустим в start для регистрации
            trial_end = datetime.fromisoformat(row[0])

        if trial_end > now:
            return await handler(event, data)

        async with db.execute(
            "SELECT 1 FROM subscriptions WHERE telegram_id = ? AND is_active = 1 AND expires_at > ?",
            (user.id, now.isoformat())
        ) as cursor:
            sub = await cursor.fetchone()
            if sub:
                return await handler(event, data)

    # Доступ заблокирован
    kb = InlineKeyboardMarkup(
        inline_keyboard=[[InlineKeyboardButton(text="💳 Оплатить подписку (100 руб.)", callback_data="buy_subscription")]]
    )
    msg = "⚠️ Пробный период закончился. Для использования функций бота необходимо оплатить подписку (100 рублей)."
    if isinstance(event, types.Message):
        await event.answer(msg, reply_markup=kb)
    elif isinstance(event, types.CallbackQuery):
        await event.message.answer(msg, reply_markup=kb)
        await event.answer()
    return


router = Router()
router.message.middleware(subscription_middleware)
router.callback_query.middleware(subscription_middleware)


