@router.message(F.text == "📚 Загрузить расписание")
async def schedule_upload_click(message: Message, state: FSMContext):
    await state.clear()
    await state.set_state(FormStates.waiting_for_schedule_text)
    await message.answer(
        "📥 Пришлите расписание **текстом** или **PDF-файлом** (поддерживаются сканы)."
    )

@router.message(FormStates.waiting_for_schedule_text, F.content_type.in_({"text", "document"}))
async def process_schedule(message: Message, state: FSMContext):
    text_content = ""
    if message.text:
        text_content = message.text
    elif message.document and message.document.mime_type == "application/pdf":
        await message.answer("⏳ Обработка PDF-файла (распознавание текста)...")
        file_bytes = await bot.download(message.document)
        pdf_data = file_bytes.read()
        
        # 1. Попытка обычного чтения
        try:
            reader = PdfReader(io.BytesIO(pdf_data))
            for page in reader.pages:
                t = page.extract_text()
                if t: text_content += t + "\n"
        except Exception as e:
            logger.error(f"PdfReader error: {e}")

        # 2. Если текста нет -> OCR через pdf2image + pytesseract
        if not text_content.strip():
            try:
                images = convert_from_bytes(pdf_data)
                for img in images:
                    text_content += pytesseract.image_to_string(img, lang="rus+eng") + "\n"
            except Exception as e:
                logger.error(f"OCR error: {e}")

    if not text_content.strip():
        await message.answer("❌ Не удалось извлечь текст из сообщения или PDF.")
        return

    # Сохраняем общий текст расписания
    await db.save_schedule_day(message.from_user.id, "общие", text_content.strip())
    await state.clear()
    await message.answer("✅ Расписание успешно сохранено!", reply_markup=get_main_keyboard())

