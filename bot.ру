@router.message(FormStates.waiting_for_custom_task_time)
async def task_save_custom_time(message: Message, state: FSMContext):
    text_input = message.text.strip()
    data = await state.get_data()
    title = data.get("title")
    await state.clear()
    
    now = datetime.datetime.now(MOSCOW_TZ)
    due_time = None
    
    try:
        if len(text_input.split()) == 2:
            due_time = datetime.datetime.strptime(text_input, "%d.%m.%Y %H:%M").replace(tzinfo=MOSCOW_TZ)
        elif len(text_input.split()) == 1 and ":" in text_input:
            h, m = map(int, text_input.split(":"))
            due_time = now.replace(hour=h, minute=m, second=0, microsecond=0)
            if due_time <= now:
                due_time += datetime.timedelta(days=1)
        else:
            raise ValueError("Invalid format")
    except Exception:
        await message.answer("❌ Неверный формат времени. Задача сохранена **без напоминания**.", reply_markup=main_menu_keyboard(), parse_mode="Markdown")
        due_time = None

    user_id = message.from_user.id
    try:
        async with aiosqlite.connect(DATABASE_PATH) as db:
            cursor = await db.execute("INSERT INTO tasks (user_id, title, due_time, is_done) VALUES (?, ?, ?, 0)", (user_id, title, due_time.isoformat() if due_time else None))
            task_id = cursor.lastrowid
            await db.commit()
            if due_time and due_time > now:
                scheduler.add_job(send_reminder, "date", run_date=due_time, args=[user_id, title], id=f"task_{task_id}", replace_existing=True)

        time_str = due_time.strftime('%d.%m.%Y %H:%M') if due_time else "Без напоминания"
        await message.answer(f"✅ Задача **«{title}»** сохранена!\n⏰ Напоминание: {time_str}", reply_markup=main_menu_keyboard(), parse_mode="Markdown")
    except Exception as e:
        logger.error(f"Task save error: {e}")
        await message.answer("❌ Запрос выдать не получилось. Попробуйте позже.", reply_markup=main_menu_keyboard())


