# ==================== ФОНОВЫЕ СЕРВИСНЫЕ ЗАДАЧИ (24/7) ====================
async def reminder_loop(bot: Bot):
    """Фоновые напоминания о задачах каждую минуту"""
    while True:
        await asyncio.sleep(60)
        try:
            now_date = datetime.now().strftime("%Y-%m-%d")
            now_time = datetime.now().strftime("%H:%M")
            
            tasks = db_execute(
                "SELECT id, user_id, task_text FROM tasks WHERE task_date = ? AND remind_time = ? AND is_notified = 0",
                (now_date, now_time),
                fetchall=True
            )
            if tasks:
                for task_id, user_id, task_text in tasks:
                    try:
                        await bot.send_message(
                            chat_id=user_id,
                            text=f"⏰ **Напоминание о деле:**\n\n📌 {task_text}"
                        )
                        db_execute("UPDATE tasks SET is_notified = 1 WHERE id = ?", (task_id,), commit=True)
                    except Exception as e:
                        logging.error(f"Не удалось отправить напоминание пользователю {user_id}: {e}")
        except Exception as e:
            logging.error(f"Ошибка в цикле напоминаний: {e}")

