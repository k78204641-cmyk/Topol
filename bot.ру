# ==================== БАЗА ДАННЫХ (SQLITE) ====================
DB_NAME = "bot_data.db"

def init_db():
    """Инициализация таблиц базы данных для пользователей и задач"""
    try:
        conn = sqlite3.connect(DB_NAME)
        cursor = conn.cursor()
        # Таблица пользователей: ID, срок подписки, текст расписания, смещение часового пояса (UTC)
        cursor.execute("""
            CREATE TABLE IF NOT EXISTS users (
                user_id INTEGER PRIMARY KEY,
                sub_until TEXT,
                schedule_text TEXT,
                utc_offset INTEGER DEFAULT 3
            )
        """)
        # Таблица задач и напоминаний
        cursor.execute("""
            CREATE TABLE IF NOT EXISTS tasks (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                user_id INTEGER,
                task_text TEXT,
                task_date TEXT,
                remind_time TEXT,
                is_notified INTEGER DEFAULT 0
            )
        """)
        conn.commit()
        conn.close()
        logging.info("База данных успешно инициализирована.")
    except Exception as e:
        logging.error(f"Ошибка инициализации БД: {e}")

init_db()

def db_execute(query, params=(), fetchone=False, fetchall=False, commit=False):
    """Безопасное выполнение SQL-запросов"""
    conn = sqlite3.connect(DB_NAME)
    try:
        cursor = conn.cursor()
        cursor.execute(query, params)
        res = None
        if fetchone:
            res = cursor.fetchone()
        elif fetchall:
            res = cursor.fetchall()
        if commit:
            conn.commit()
        return res
    finally:
        conn.close()

