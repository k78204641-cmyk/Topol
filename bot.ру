@router.callback_query(F.data.startswith("time_"), BotStates.waiting_for_task_time)
async def task_preset_time(callback_query: CallbackQuery, state: FSMContext):
    choice = callback_query.data.split("_")[1]
    now = datetime.datetime.now(MOSCOW_TZ)
    due_time = None
    if choice == "1h": due_time = now + datetime.timedelta(hours=1)
    elif choice == "today": due_time = now.replace(hour=20, minute=0, second=0, microsecond=0)
    elif choice == "tom9": due_time = (now + datetime.timedelta(days=1)).replace(hour=9, minute=0, second=0, microsecond=0)

    user_id = callback_query.from_user.id
    data = await state.get_data()
    title = data.get("title")
    await state.clear()

    async with aiosqlite.connect(DATABASE_PATH) as db:
        cursor = await db.execute("INSERT INTO tasks (user_id, title, due_time, is_done) VALUES (?, ?, ?, 0)", (user_id, title, due_time.isoformat() if due_time else None))
        task_id = cursor.lastrowid
        await db.commit()
        if due_time:
            scheduler.add_job(send_reminder, "date", run_date=due_time, args=[user_id, title], id=f"task_{task_id}", replace_existing=True)

    await callback_query.message.edit_text(f"✅ Задача **«{title}»** сохранена!", parse_mode="Markdown")
    await callback_query.message.answer("Главное меню:", reply_markup=main_menu_keyboard())
    await callback_query.answer()


