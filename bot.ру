# --- Функционал расписания ---
async def send_schedule_callback(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    user_id = query.from_user.id
    
    conn = sqlite3.connect("bot_database.db")
    cursor = conn.cursor()
    cursor.execute("SELECT task_text, remind_time FROM tasks WHERE telegram_id = ?", (user_id,))
    tasks = cursor.fetchall()
    conn.close()
    
    current_date = datetime.now().strftime("%d.%m.%Y")
    schedule_text = f"📅 Ваши задачи и расписание на {current_date}:\n\n"
    if tasks:
        for i, (t_text, t_time) in enumerate(tasks, 1):
            schedule_text += f"{i}. [{t_time}] — {t_text}\n"
    else:
        schedule_text += "На сегодня нет записанных дел."
    
    await query.message.reply_text(schedule_text, reply_markup=get_main_menu())


# --- Фоновые напоминания (JobQueue) ---
async def check_reminders(context: ContextTypes.DEFAULT_TYPE):
    now_str = datetime.now().strftime("%H:%M")
    conn = sqlite3.connect("bot_database.db")
    cursor = conn.cursor()
    cursor.execute(
        "SELECT id, telegram_id, task_text FROM tasks WHERE remind_time = ? AND is_notified = 0",
        (now_str,)
    )
    tasks = cursor.fetchall()
    
    for task_id, user_id, task_text in tasks:
        try:
            await context.bot.send_message(
                chat_id=user_id,
                text=f"⏰ **Напоминание о деле:**\n{task_text}"
            )
            cursor.execute("UPDATE tasks SET is_notified = 1 WHERE id = ?", (task_id,))
            conn.commit()
        except Exception as e:
            logger.error(f"Не удалось отправить напоминание пользователю {user_id}: {e}")
    conn.close()


# --- Главная функция запуска ---
def main():
    init_db()
    
    application = Application.builder().token(TOKEN).build()

    # ConversationHandler для регистрации
    reg_handler = ConversationHandler(
        entry_points=[CommandHandler("start", start)],
        states={
            ZODIAC: [CallbackQueryHandler(receive_zodiac)],
            CITY: [MessageHandler(filters.TEXT & ~filters.COMMAND, receive_city)],
        },
        fallbacks=[],
    )

    # ConversationHandler для добавления задачи
    task_handler = ConversationHandler(
        entry_points=[CallbackQueryHandler(start_add_task, pattern="^menu_add_task$")],
        states={
            TASK_TEXT: [MessageHandler(filters.TEXT & ~filters.COMMAND, receive_task_text)],
            TASK_TIME: [MessageHandler(filters.TEXT & ~filters.COMMAND, receive_task_time)],
        },
        fallbacks=[],
    )

    application.add_handler(reg_handler)
    application.add_handler(task_handler)

    # Обработчики инлайн-кнопок главного меню
    application.add_handler(CallbackQueryHandler(send_weather_callback, pattern="^menu_weather$"))
    application.add_handler(CallbackQueryHandler(send_horoscope_callback, pattern="^menu_horoscope$"))
    application.add_handler(CallbackQueryHandler(send_schedule_callback, pattern="^menu_schedule$"))

    # Настройка планировщика задач (проверка напоминаний каждую минуту)
    job_queue = application.job_queue
    job_queue.run_repeating(check_reminders, interval=60, first=5)

    logger.info("Бот запущен...")
    application.run_polling()


if __name__ == "__main__":
    main()
