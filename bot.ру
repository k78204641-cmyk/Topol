                summary = show.get("summary", "Описание отсутствует.").replace("<p>", "").replace("</p>", "").replace("<b>", "").replace("</b>", "").replace("<i>", "").replace("</i>", "")
                poster = show.get("image", {}).get("original") or show.get("image", {}).get("medium")

                caption = f"🎬 **{name}**\n⭐️ Рейтинг: {rating}\n\n📝 {summary[:400]}"
                
                if poster:
                    await message.answer_photo(photo=poster, caption=caption, parse_mode="Markdown")
                await message.answer_video(video=SAMPLE_VIDEO_URL, caption=f"▶️ Видеоматериал для: *{name}*", parse_mode="Markdown")
                await message.answer("Главное меню:", reply_markup=main_menu_keyboard())
        except Exception as e:
            logger.error(f"Movie search error: {e}")
            try: await bot.delete_message(chat_id=message.chat.id, message_id=search_msg.message_id)
            except Exception: pass
            
            fallback = CURATED_MOVIES["уэнсдэй"]
            caption = f"🎬 **{fallback['name']}**\n⭐️ Рейтинг: {fallback['rating']}\n\n📝 {fallback['summary']}"
            await message.answer_photo(photo=fallback['poster'], caption=caption, parse_mode="Markdown")
            await message.answer_video(video=SAMPLE_VIDEO_URL, caption="▶️ Видеоматериал", parse_mode="Markdown")
