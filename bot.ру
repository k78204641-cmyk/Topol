# ==================== ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ ====================
class HTMLTextExtractor(HTMLParser):
    def __init__(self):
        super().__init__()
        self.result = []

    def handle_data(self, data):
        cleaned = data.strip()
        if cleaned:
            self.result.append(cleaned)

    def get_text(self):
        return "\n".join(self.result)

def clean_html_to_text(html_content: str) -> str:
    parser = HTMLTextExtractor()
    parser.feed(html_content)
    return parser.get_text()

def parse_date_input(text: str) -> str:
    """Преобразует 'сегодня', 'завтра' или '10.10.2026' в каноничную дату YYYY-MM-DD"""
    today = datetime.now()
    text_lower = text.strip().lower()
    
    if text_lower in ["сегодня", "today"]:
        return today.strftime("%Y-%m-%d")
    elif text_lower in ["завтра", "tomorrow"]:
        return (today + timedelta(days=1)).strftime("%Y-%m-%d")
    
    # Попытка разобрать DD.MM.YYYY или DD.MM
    try:
        parts = text_lower.split(".")
        if len(parts) == 2:
            day, month = int(parts[0]), int(parts[1])
            year = today.year
            dt = datetime(year, month, day)
            return dt.strftime("%Y-%m-%d")
        elif len(parts) == 3:
            day, month, year = int(parts[0]), int(parts[1]), int(parts[2])
            if year < 100:
                year += 2000
            dt = datetime(year, month, day)
            return dt.strftime("%Y-%m-%d")
    except Exception:
        pass
    
    return text.strip()

# ==================== ПОГОДА ====================
async def fetch_weather(city: str) -> str:
    url = f"https://wttr.in/{city}?format=j1&lang=ru"
    try:
        async with aiohttp.ClientSession() as session:
            async with session.get(url, timeout=8) as resp:
                if resp.status != 200:
                    return f"❌ Город «{city}» не найден. Проверьте правильность названия."
                data = await resp.json()
                
                curr = data['current_condition'][0]
                temp = curr['temp_C']
                feels = curr['FeelsLikeC']
                desc = curr['lang_ru'][0]['value'] if 'lang_ru' in curr and curr['lang_ru'] else curr['weatherDesc'][0]['value']
                humidity = curr['humidity']
                wind = curr['windspeedKmph']

                return (
                    f"🌤 **Погода в г. {city.capitalize()}:**\n\n"
                    f"• Температура: {temp}°C (ощущается как {feels}°C)\n"
                    f"• На улице: {desc}\n"
                    f"• Влажность: {humidity}%\n"
                    f"• Ветер: {wind} км/ч"
                )
    except Exception as e:
        return f"❌ Не удалось получить данные о погоде: {e}"

# ==================== РАСПИСАНИЕ ИЗ ССЫЛКИ ====================
async def fetch_schedule_from_link(url: str, raw_date_query: str) -> str:
    parsed_date = parse_date_input(raw_date_query)
    
    try:
        headers = {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64)"}
        async with aiohttp.ClientSession() as session:
            async with session.get(url, headers=headers, timeout=12) as resp:
                if resp.status != 200:
                    return f"⚠️ Ошибка загрузки страницы по ссылке (Код HTTP: {resp.status})."
                
                html_body = await resp.text()
                plain_text = clean_html_to_text(html_body)

        lines = [line.strip() for line in plain_text.split("\n") if line.strip()]
        
        keywords = [raw_date_query.lower()]
        try:
            dt = datetime.strptime(parsed_date, "%Y-%m-%d")
            months = ["января", "февраля", "марта", "апреля", "мая", "июня", "июля", "августа", "сентября", "октября", "ноября", "декабря"]
            weekdays = ["понедельник", "вторник", "среда", "четверг", "пятница", "суббота", "воскресенье"]
            keywords.append(f"{dt.day:02d}.{dt.month:02d}")
            keywords.append(f"{dt.day} {months[dt.month-1]}")
            keywords.append(weekdays[dt.weekday()])
        except Exception:
            pass

        matched_blocks = []
        capturing = False
        current_block = []

        for line in lines:
            line_low = line.lower()
            if any(kw in line_low for kw in keywords):
                if current_block:
                    matched_blocks.append("\n".join(current_block))
                    current_block = []
                capturing = True

            if capturing:
                current_block.append(line)
                if len(current_block) >= 10:
                    matched_blocks.append("\n".join(current_block))
                    current_block = []
                    capturing = False

        if current_block:
            matched_blocks.append("\n".join(current_block))

        if matched_blocks:
            res_text = "\n\n---\n\n".join(matched_blocks[:2])
            if len(res_text) > 3500:
                res_text = res_text[:3500] + "\n...(текст сокращен)"
            return f"📅 **Расписание на {raw_date_query}:**\n\n{res_text}"
        else:
            return f"ℹ️ На странице расписания не найдены записи для даты/дня «{raw_date_query}»."

    except Exception as e:
        return f"❌ Ошибка при попытке чтения расписания: {str(e)}"

