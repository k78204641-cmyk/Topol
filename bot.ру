async def fetch_weather(city_name: str) -> str:
    encoded_city = quote(city_name.strip())
    url = f"https://wttr.in/{encoded_city}?m&format=4&lang=ru"
    headers = {"User-Agent": "curl/7.68.0"}
    timeout = aiohttp.ClientTimeout(total=8)
    
    try:
        async with aiohttp.ClientSession(headers=headers, timeout=timeout) as session:
            async with session.get(url) as resp:
                if resp.status != 200:
                    return f"❌ Город «{city_name}» не найден или сервис погоды недоступен."
                
                text = await resp.text()
                if not text or "Unknown location" in text or "Sorry" in text or "<html" in text.lower():
                    return f"❌ Город «{city_name}» не найден. Проверьте правильность написания."
                
                return f"🌍 **Погода (°C):**\n\n{text.strip()}"
    except asyncio.TimeoutError:
        return "⏳ Время ожидания ответа от сервера погоды истекло."
    except Exception as e:
        logger.error(f"Weather error: {e}")
        return f"❌ Не удалось получить погоду для города «{city_name}»."

