async def check_reminders_job():
    now_msk = datetime.now(MSK_TZ).isoformat()
    reminders = await get_pending_reminders(now_msk)
    for r_id, u_id, task_text in reminders:
        try:
            await bot.send_message(u_id, f"⏰ **НАПОМИНАНИЕ:**\n\n{task_text}", parse_mode="Markdown")
            await mark_reminder_sent(r_id)
        except Exception as e:
            logger.error(f"Ошибка отправки напоминания {r_id}: {e}")

async def keep_alive_ping():
    await asyncio.sleep(20)
    url = "https://topol.onrender.com"
    async with aiohttp.ClientSession() as session:
        while True:
            try:
                async with session.get(url) as resp:
                    logger.info(f"Keep-alive ping sent, status: {resp.status}")
            except Exception as e:
                logger.error(f"Keep-alive ping error: {e}")
            await asyncio.sleep(300)

async def handle_dummy_web(request):
    return web.Response(text="Bot is running perfectly on Render!")

async def start_dummy_server():
    app = web.Application()
    app.router.add_get("/", handle_dummy_web)
    runner = web.AppRunner(app)
    await runner.setup()
    port = int(os.environ.get("PORT", 8080))
    site = web.TCPSite(runner, "0.0.0.0", port)
    await site.start()

# ==================== ЗАПУСК ====================

async def main():
    await init_db()

    scheduler = AsyncIOScheduler(timezone=MSK_TZ)
    scheduler.add_job(check_reminders_job, "interval", seconds=30)
    scheduler.start()

    dp.include_router(router)

    await bot.delete_webhook(drop_pending_updates=True)
    await start_dummy_server()
    
    asyncio.create_task(keep_alive_ping())

    logger.info("Бот успешно запущен!")
    await dp.start_polling(bot)

if __name__ == "__main__":
    asyncio.run(main())
