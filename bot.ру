    """Рассылка сообщений утором ТОЛЬКО пользователям с активной подпиской."""
    users = get_all_users()
    logger.info("Запуск утренней рассылки...")
    
    for user in users:
        user_id = user[0]
        expires_str = user[4]
        
        # Проверяем подписку
        if expires_str and datetime.now() < datetime.fromisoformat(expires_str):
            try:
                text = await build_morning_message(user_id)
                await bot.send_message(user_id, text, disable_web_page_preview=True)
                await asyncio.sleep(0.05)
            except Exception as e:
                logger.error(f"Не удалось отправить рассылку {user_id}: {e}")
        else:
            # Напоминание об истекшей подписке при рассылке
            try:
                await bot.send_message(
                    user_id, 
                    "⏰ **Время утреннего дайджеста!**

Ваш бесплатный период/подписка истекли. Оформите подписку за 150 руб./мес, чтобы снова получать утренние сводки.",
                    reply_markup=get_pay_keyboard()
                )
            except Exception:
                pass


