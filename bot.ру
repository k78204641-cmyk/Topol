# --- Инициализация базы данных SQLite ---
def init_db():
    conn = sqlite3.connect("bot_database.db")
    cursor = conn.cursor()
    # Таблица пользователей
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS users (
            telegram_id INTEGER PRIMARY KEY,
            zodiac TEXT,
            city TEXT
        )
    """)
    # Таблица задач (дневник дел)
    cursor.execute("""
        CREATE TABLE IF NOT EXISTS tasks (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            telegram_id INTEGER,
            task_text TEXT,
            remind_time TEXT,
            is_notified INTEGER DEFAULT 0
        )
    """)
    conn.commit()
    conn.close()


# --- Главное меню ---
def get_main_menu():
    keyboard = [
        [
            InlineKeyboardButton("🌤 Погода", callback_data="menu_weather"),
            InlineKeyboardButton("🔮 Гороскоп", callback_data="menu_horoscope")
        ],
        [
            InlineKeyboardButton("📅 Расписание и дела", callback_data="menu_schedule"),
            InlineKeyboardButton("📝 Добавить дело", callback_data="menu_add_task")
        ]
    ]
    return InlineKeyboardMarkup(keyboard)


# --- Сценарий регистрации (FSM) ---
async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    conn = sqlite3.connect("bot_database.db")
    cursor = conn.cursor()
    cursor.execute("SELECT * FROM users WHERE telegram_id = ?", (user_id,))
    user = cursor.fetchone()
    conn.close()

    if user:
        await update.message.reply_text(
            "С возвращением! Вы уже зарегистрированы. Выберите нужное действие в меню:",
            reply_markup=get_main_menu()
        )
        return ConversationHandler.END

    # Формируем клавиатуру со знаками зодиака (по 2 в ряд)
    rows = []
    for i in range(0, len(ZODIAC_SIGNS), 2):
        row = [InlineKeyboardButton(ZODIAC_SIGNS[i], callback_data=ZODIAC_SIGNS[i])]
        if i + 1 < len(ZODIAC_SIGNS):
            row.append(InlineKeyboardButton(ZODIAC_SIGNS[i+1], callback_data=ZODIAC_SIGNS[i+1]))
        rows.append(row)
    
    await update.message.reply_text(
        "Привет! Я твой личный бот-ассистент.\n\nДавай настроим профиль.\nШаг 1: Выбери свой знак зодиака:",
        reply_markup=InlineKeyboardMarkup(rows)
    )
    return ZODIAC


async def receive_zodiac(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    zodiac = query.data
    context.user_data['zodiac'] = zodiac

    await query.edit_message_text(
        text=f"Знак зодиака сохранен: {zodiac}.\n\nШаг 2: Введи текстовым сообщением свой город для прогноза погоды:"
    )
    return CITY


async def receive_city(update: Update, context: ContextTypes.DEFAULT_TYPE):
    city = update.message.text.strip()
    user_id = update.effective_user.id
    zodiac = context.user_data.get('zodiac')

    conn = sqlite3.connect("bot_database.db")
    cursor = conn.cursor()
    cursor.execute(
        "INSERT OR REPLACE INTO users (telegram_id, zodiac, city) VALUES (?, ?, ?)",
        (user_id, zodiac, city)
    )
    conn.commit()
    conn.close()

    await update.message.reply_text(
        f"✅ Регистрация успешно завершена!\nЗнак зодиака: {zodiac}\nГород: {city}",
        reply_markup=get_main_menu()
    )
    return ConversationHandler.END


# --- Сценарий добавления задач (FSM) ---
async def start_add_task(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    await query.message.reply_text("📝 Введите текст вашего дела или заметки:")
    return TASK_TEXT


async def receive_task_text(update: Update, context: ContextTypes.DEFAULT_TYPE):
    context.user_data['task_text'] = update.message.text
    await update.message.reply_text("⏰ Введите время для напоминания в формате ЧЧ:ММ (например, 14:30):")
    return TASK_TIME


async def receive_task_time(update: Update, context: ContextTypes.DEFAULT_TYPE):
    time_str = update.message.text.strip()
    try:
        datetime.strptime(time_str, "%H:%M")
    except ValueError:
        await update.message.reply_text("Неверный формат времени. Пожалуйста, введите в формате ЧЧ:ММ (например, 14:30):")
        return TASK_TIME

    user_id = update.effective_user.id
    task_text = context.user_data.get('task_text')

    conn = sqlite3.connect("bot_database.db")
    cursor = conn.cursor()
    cursor.execute(
        "INSERT INTO tasks (telegram_id, task_text, remind_time, is_notified) VALUES (?, ?, ?, 0)",
        (user_id, task_text, time_str)
    )
    conn.commit()
    conn.close()

    await update.message.reply_text(
        f"✅ Дело успешно записано!\nЗадача: {task_text}\nВремя напоминания: {time_str}",
        reply_markup=get_main_menu()
    )
    return ConversationHandler.END


# --- Функционал погоды (Интеграция с OpenWeatherMap) ---
async def fetch_weather(city: str) -> str:
    url = f"http://api.openweathermap.org/data/2.5/weather?q={city}&appid={WEATHER_API_KEY}&units=metric&lang=ru"
    try:
        async with httpx.AsyncClient() as client:
            response = await client.get(url, timeout=5.0)
            if response.status_code == 200:
                data = response.json()
                temp = data["main"]["temp"]
                desc = data["weather"][0]["description"]
                return f"🌤 Погода в городе {city}:\nТемпература: {temp}°C, {desc.capitalize()}."
    except Exception as e:
        logger.error(f"Ошибка запроса погоды: {e}")
    
    # Заглушка, если ключ недействителен или недоступен интернет
    return f"🌤 Погода в городе {city} (заглушка): +21°C, переменная облачность."


async def send_weather_callback(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    user_id = query.from_user.id
    
    conn = sqlite3.connect("bot_database.db")
    cursor = conn.cursor()
    cursor.execute("SELECT city FROM users WHERE telegram_id = ?", (user_id,))
    row = cursor.fetchone()
    conn.close()
    
    city = row[0] if row and row[0] else "Москва"
    weather_text = await fetch_weather(city)
    await query.message.reply_text(weather_text, reply_markup=get_main_menu())


