# ==================== ПЛАНИРОВЩИК НАПОМИНАНИЙ ====================
async def check_reminders(bot: Bot):
    now = datetime.now(MSK)
    current_date = now.strftime("%Y-%m-%d")
    current_time = now.strftime("%H:%M")
    
    tasks = db_execute(
        "SELECT id, user_id, title, task_date, task_time, recurrence FROM tasks WHERE is_active = 1 AND task_date <= ? AND task_time <= ?",
        (current_date, current_time),
        fetchall=True
    )
    
    for task in tasks:
        task_id, user_id, title, t_date, t_time, recurrence = task
        # Отправляем напоминание
        try:
            await bot.send_message(
                chat_id=user_id,
                text=f"⏰ **Напоминание о деле!**\n\n📌 {title}\n🕒 Запланировано на {t_date} в {t_time} (МСК)"
            )
        except Exception as e:
            logger.error(f"Failed to send reminder to {user_id}: {e}")
        
        # Обработка повторений или деактивация
        if recurrence == "none":
            db_execute("UPDATE tasks SET is_active = 0 WHERE id = ?", (task_id,), commit=True)
        elif recurrence == "daily":
            next_date = (datetime.strptime(t_date, "%Y-%m-%d") + timedelta(days=1)).strftime("%Y-%m-%d")
            db_execute("UPDATE tasks SET task_date = ? WHERE id = ?", (next_date, task_id), commit=True)
        elif recurrence == "weekdays":
            dt = datetime.strptime(t_date, "%Y-%m-%d")
            days_add = 3 if dt.weekday() == 4 else (2 if dt.weekday() == 5 else 1)
            next_date = (dt + timedelta(days=days_add)).strftime("%Y-%m-%d")
            db_execute("UPDATE tasks SET task_date = ? WHERE id = ?", (next_date, task_id), commit=True)
        elif recurrence == "weekly":
            next_date = (datetime.strptime(t_date, "%Y-%m-%d") + timedelta(days=7)).strftime("%Y-%m-%d")
            db_execute("UPDATE tasks SET task_date = ? WHERE id = ?", (next_date, task_id), commit=True)

